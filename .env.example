# Общая БД auth-сервиса и akira-server (docker compose up -d).
# 127.0.0.1, а не localhost: localhost может сначала резолвиться в ::1,
# и подключение к не слушающему IPv6 stall-ит до таймаута.
DATABASE_URL="postgres://akira:akira@127.0.0.1:5432/akira"

LISTEN=":5000"
MAX_CONNECTIONS="5"

AUTH_LISTEN=":6000"
AUTH_ISSUER="akira"
AUTH_ACCESS_TTL="15m"
AUTH_REFRESH_TTL="720h"
# Срок жизни кода подтверждения email (6 цифр, 5 попыток ввода).
AUTH_EMAIL_TTL="15m"
AUTH_BOOTSTRAP_USERNAME="admin"
AUTH_BOOTSTRAP_PASSWORD="dev"
AUTH_BOOTSTRAP_EMAIL="admin@bootstrap.local"

# SMTP: пустой SMTP_HOST — письма не отправляются, коды подтверждения
# пишутся в лог.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="akira@localhost"

MCP_PUBLIC_URL="http://localhost:7000"

# Публичный адрес стека (через nginx) — из него строятся абсолютные
# ссылки в OAuth-метаданных (AUTH_PUBLIC_URL, MCP_PUBLIC_URL,
# MCP_AUTH_SERVER_URL в docker-compose). На сервере — реальный домен,
# например https://akira.otsa.city; по умолчанию http://localhost.
# PUBLIC_URL="http://localhost"

# Базовый URL фронтенда, куда /authorize редиректит на форму логина.
# Пусто (по умолчанию) — встроенный фронтенд auth-сервиса (вход,
# регистрация, подтверждение email, дашборд, OAuth-форма MCP-хостов;
# см. internal/auth/httpapi/web). Задайте, только если выносите UI
# в отдельное приложение.
# AUTH_FRONTEND_URL=""

LOG_LEVEL="debug"
